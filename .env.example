# Nixflow self-hosted settings. Don't copy this by hand — run ./setup.sh, which
# writes .env with fresh random secrets. This file documents every option.

# ── Addresses ────────────────────────────────────────────────────────────────
# Where people open Nixflow and its admin portal (team, roles, AI key). Use
# your HTTPS addresses in production (put a reverse proxy with TLS in front of
# HTTP_PORT / ADMIN_HTTP_PORT). Changing these only needs `docker compose up -d`.
PUBLIC_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081
HTTP_PORT=8080
ADMIN_HTTP_PORT=8081

# ── Secrets (setup.sh generates these — never reuse the examples) ────────────
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# Encrypts saved connection credentials. Back it up; never change it once set.
ENCRYPTION_KEY=

# ── Sign-up and sign-in emails ───────────────────────────────────────────────
# true = nobody can create a new account (invite-only after the first one).
DISABLE_SIGNUP=false
# With no mail server, accounts are confirmed immediately. Set SMTP_* and
# EMAIL_AUTOCONFIRM=false to require email confirmation and enable resets.
EMAIL_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Nixflow

# ── Invitation / welcome emails sent by Nixflow (optional) ───────────────────
# A Resend (resend.com) API key, and a sender on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM="Nixflow <noreply@your-domain.com>"

# ── AI (optional) ────────────────────────────────────────────────────────────
# Usually left empty: each workspace adds its own AI key in the admin portal.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Nixflow release to run (default: latest). Pin one, e.g. 1.0.0, to upgrade
# only when you choose: change it, then `docker compose pull && docker compose up -d`.
# NIXFLOW_VERSION=1.0.0
